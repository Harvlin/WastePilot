VITE_INTERNAL_API_PROVIDER=spring
# When running via docker-compose, the backend is exposed on port 8088 (APP_EXTERNAL_PORT in wastepilot/.env).
# When running the backend locally with ./mvnw spring-boot:run, change this back to http://localhost:8080.
VITE_SPRING_API_BASE_URL=http://localhost:8088
VITE_SPRING_API_TIMEOUT_MS=10000
VITE_SPRING_FALLBACK_TO_MOCK=true
