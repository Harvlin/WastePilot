# =============================================================================
# WastePilot Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
#
# ── Railway deployment: required environment variables ─────────────────────
# The following variables MUST be set on the Railway Spring Boot service for
# a clean startup. Missing any one of them causes a startup failure.
# SecurityStartupValidator reports ALL missing secrets in a single message.
#
#   SPRING_PROFILES_ACTIVE=docker
#   DB_HOST            — Railway MySQL internal hostname (e.g. mysql.railway.internal)
#   DB_PORT            — 3306
#   DB_NAME            — your Railway MySQL database name
#   DB_USER            — your Railway MySQL user
#   DB_PASSWORD        — your Railway MySQL password
#   DB_SSL_MODE        — DISABLED  (see note below; DO NOT use VERIFY_IDENTITY)
#   CORS_ALLOWED_ORIGIN_0 — your deployed frontend URL
#   JWT_SECRET         — openssl rand -base64 32
#   AUDIT_CHAIN_HMAC_KEY  — openssl rand -hex 32
#   SENSOR_INGEST_API_KEY — generate a strong random key
#   GEMINI_API_KEY     — real Google AI Studio key (warn-only if missing; OCR degrades)
#   GEMINI_MODEL       — e.g. gemini-1.5-flash
#
# Optional (safe defaults exist):
#   SERVER_PORT                    (default 8080)
#   JWT_ACCESS_TOKEN_TTL_SECONDS   (default 28800 = 8 h)
#   JWT_REFRESH_TOKEN_TTL_SECONDS  (default 604800 = 7 d)
#   SPRING_JPA_HIBERNATE_DDL_AUTO  (default validate)
#   MAX_UPLOAD_FILE_SIZE           (default 10MB)
#   MAX_UPLOAD_REQUEST_SIZE        (default 10MB)
#   ANOMALY_COLD_START_THRESHOLD_KG (default 10)
# =============================================================================
#
# Tip: In Railway, reference MySQL service variables directly:
#   DB_HOST  = ${{MySQL.MYSQLHOST}}
#   DB_PORT  = ${{MySQL.MYSQLPORT}}
#   DB_NAME  = ${{MySQL.MYSQLDATABASE}}
#   DB_USER  = ${{MySQL.MYSQLUSER}}
#   DB_PASSWORD = ${{MySQL.MYSQLPASSWORD}}
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
APP_EXTERNAL_PORT=8088
ADMINER_EXTERNAL_PORT=8888

# ── Database ─────────────────────────────────────────────────────────────────
DB_EXTERNAL_PORT=3307
DB_HOST=localhost
DB_PORT=3306
# DB_SSL_MODE controls how the JDBC driver validates the MySQL server's TLS certificate.
#
# Railway internal networking (same project — standard deployment):
#   Set DB_SSL_MODE=DISABLED
#   The app and MySQL run in the same Railway project and communicate over Railway's private
#   virtual network. Traffic never crosses the public internet. Railway's MySQL uses a
#   self-signed certificate that is NOT in the JVM's default truststore, so VERIFY_CA and
#   VERIFY_IDENTITY will always fail. DISABLED is the correct and Railway-recommended setting
#   for same-project internal connections.
#
#   DO NOT set VERIFY_IDENTITY or VERIFY_CA for Railway managed MySQL — Railway does not
#   expose a downloadable CA certificate for their standard MySQL offering, and the auto-
#   generated self-signed cert will never chain to the JVM cacerts trust anchors.
#
# External / public TCP proxy (connecting to Railway MySQL from outside Railway):
#   Set DB_SSL_MODE=REQUIRED
#   This encrypts the connection without attempting CA chain validation. It is acceptable
#   for external access since the connection goes over a TLS-encrypted channel even without
#   hostname verification. VERIFY_CA / VERIFY_IDENTITY are still not usable without a
#   downloadable CA cert.
#
# docker-compose local dev (MySQL in the compose network):
#   DISABLED is correct — the MySQL container uses a self-signed cert and both containers
#   are on a private Docker bridge network, not the public internet.
#
# The application-docker.properties default fallback is REQUIRED (not VERIFY_IDENTITY)
# so that a missing env var causes encrypted-but-unverified rather than a startup crash.
DB_SSL_MODE=DISABLED
DB_NAME=wastepilot
DB_USER=wastepilot
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_STRONG_DB_ROOT_PASSWORD
CORS_ALLOWED_ORIGIN_0=http://localhost:5173

# ── JPA / Flyway ─────────────────────────────────────────────────────────────
# Use "validate" in production, "update" or "create" for local dev
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ── Security ──────────────────────────────────────────────────────────────────
# PRODUCTION FAIL-FAST: When running without a local/test profile,
# the application will REFUSE TO START if JWT_SECRET is left as the default.
# This now covers ANY profile outside "local" and "test" (including no profile).
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_ACCESS_TOKEN_TTL_SECONDS=28800

# ── Audit Chain HMAC ─────────────────────────────────────────────────────────
# PRODUCTION FAIL-FAST: Checked by SecurityStartupValidator (alongside JWT_SECRET
# and SENSOR_INGEST_API_KEY) — all three are reported together in one error message
# if any are missing, so a single deploy attempt reveals all missing secrets at once.
# This key is used to HMAC-SHA256 the audit trail — keeping it outside the DB
# ensures that DB-only access cannot recompute the chain without this key.
# Generate: openssl rand -hex 32
AUDIT_CHAIN_HMAC_KEY=REPLACE_WITH_STRONG_HMAC_KEY

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Required for Docker/prod. Set a real key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# ── Sensor Ingest ─────────────────────────────────────────────────────────────
# Shared prototype credential for trusted sensor senders (not a user JWT).
SENSOR_INGEST_API_KEY=REPLACE_WITH_STRONG_SENSOR_INGEST_KEY

# Per-device sensor keys (optional): overrides the shared key for a specific device ID.
# Devices send their deviceId field in the ingest payload; the matching key is looked up.
# Property format: wastepilot.sensor.device-keys.{deviceId}=key
# Example (in application.properties or docker-compose env):
#   wastepilot.sensor.device-keys.scale-001=REPLACE_WITH_SCALE_001_KEY
#   wastepilot.sensor.device-keys.belt-002=REPLACE_WITH_BELT_002_KEY
