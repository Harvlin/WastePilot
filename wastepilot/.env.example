# =============================================================================
# WastePilot Backend — Local Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
APP_EXTERNAL_PORT=8088
ADMINER_EXTERNAL_PORT=8888

# ── Database ─────────────────────────────────────────────────────────────────
DB_EXTERNAL_PORT=3307
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wastepilot
DB_USER=wastepilot
DB_PASSWORD=wastepilot
DB_ROOT_PASSWORD=rootpassword

# ── JPA / Flyway ─────────────────────────────────────────────────────────────
# Use "validate" in production, "update" or "create" for local dev
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ── Security ──────────────────────────────────────────────────────────────────
# PRODUCTION FAIL-FAST: When running with spring.profiles.active=docker or prod,
# the application will REFUSE TO START if JWT_SECRET is left as the default.
# This prevents the well-known development secret from signing real production JWTs.
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_ACCESS_TOKEN_TTL_SECONDS=28800

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# WARNING: When running with docker/prod profile and this key is the mock default,
# the application will log a startup WARNING. OCR-based inventory scanning will
# not function. Set to a real key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
